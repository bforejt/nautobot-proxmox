#!/bin/bash
# NFV firstboot — {{ node_name }} (serial {{ serial }})
# Fetched once at install time via the answer file's [first-boot] from-url
# (one-time key), baked into the installed system by proxmox-first-boot, and
# run on the node's first boot. Idempotent where it matters; logs to journal.
#
# Scope: apt repos, the pveum service-account bootstrap, the credentials
# phone-home, and the profile's data storage step: install.data_pool (JBOD
# boxes: ZFS data mirror) or install.data_volume (RAID-adapter boxes such as
# the SE455 V3: LVM-thin on the data virtual drive), registered as PVE storage.
# Then the host-baseline inputs (decision #55): packages, serial console, ZFS
# ARC limit and the subscription-nag hook, from the Device's config context
# (host_baseline) and the profile (install.serial_console). Everything else of
# the baseline (SNMP, AD, service accounts, bonds/bridges) is the Host Baseline
# job's. Physical-node tuning steps (BIOS-effect checks, NIC quirks) remain
# plan-of-attack Phase 3.
set -euo pipefail
log() { echo "[nfv-firstboot] $*"; }

# All SoT-sourced values enter as shell-quoted literals ONCE, here, and are
# referenced as variables everywhere below — never re-injected into another
# quoting context.
NODE_NAME={{ node_name | shquote }}
SERIAL={{ serial | shquote }}
SERVICE_URL={{ service_url | shquote }}
CRED_KEY={{ credentials_key | shquote }}
PIN_FP={{ cert_fingerprint | shquote }}
ROLE={{ pve_role | shquote }}
PRIVS={{ pve_privs | shquote }}
SVC_USER={{ pve_user | shquote }}
TOKEN_NAME={{ pve_token | shquote }}

log "starting on $(hostname) (expecting ${NODE_NAME})"

# --- apt: community repo, drop the enterprise entries (no subscription) ---
rm -f /etc/apt/sources.list.d/pve-enterprise.list \
      /etc/apt/sources.list.d/pve-enterprise.sources \
      /etc/apt/sources.list.d/ceph.list /etc/apt/sources.list.d/ceph.sources
codename="$(. /etc/os-release && echo "${VERSION_CODENAME}")"
cat > /etc/apt/sources.list.d/pve-no-subscription.sources <<EOF
Types: deb
URIs: http://download.proxmox.com/debian/pve
Suites: ${codename}
Components: pve-no-subscription
Signed-By: /usr/share/keyrings/proxmox-archive-keyring.gpg
EOF
log "apt repos set to pve-no-subscription (${codename})"

# --- pveum service-account bootstrap (decision: per-node token, least priv;
#     grant the role to BOTH user and token — privsep rights are the
#     INTERSECTION of the two ACL sets) ---
pveum role list --output-format json | grep -q "\"${ROLE}\"" \
  || pveum role add "${ROLE}" -privs "${PRIVS}"
pveum user list --output-format json | grep -q "\"${SVC_USER}\"" \
  || pveum user add "${SVC_USER}" --comment "NFV automation (firstboot-created)"
pveum acl modify / --users "${SVC_USER}" --roles "${ROLE}"
# Re-runnable under set -e: a token left by an earlier run that died before
# the phone-home was never stored anywhere — its secret is unrecoverable and
# useless, and `token add` would fail on it. Rotate it: remove, then add anew
# (the token ACL is re-granted below; removal drops the old one with it).
if pveum user token list "${SVC_USER}" --output-format json \
    | python3 -c 'import json,sys; sys.exit(0 if any(t.get("tokenid") == sys.argv[1] for t in json.load(sys.stdin)) else 1)' "${TOKEN_NAME}"; then
  log "token ${SVC_USER}!${TOKEN_NAME} exists from an unfinished earlier run — rotating it"
  pveum user token remove "${SVC_USER}" "${TOKEN_NAME}"
fi
# Token value is shown exactly once — capture it here or lose it (reinstall
# re-runs this same bootstrap, which is the designed rebuild path).
TOKEN_SECRET="$(pveum user token add "${SVC_USER}" "${TOKEN_NAME}" --privsep 1 --output-format json \
  | python3 -c 'import json,sys; print(json.load(sys.stdin)["value"])')"
pveum acl modify / --tokens "${SVC_USER}!${TOKEN_NAME}" --roles "${ROLE}"
log "service account ${SVC_USER}!${TOKEN_NAME} created with role ${ROLE} (user+token ACLs)"

# --- phone the credentials home (one-time key; retried — the key is only
#     consumed server-side on success, so retrying is safe). Values pass via
#     the environment: nothing is interpolated into the Python source. ---
export NFV_URL="${SERVICE_URL}" NFV_SERIAL="${SERIAL}" NFV_KEY="${CRED_KEY}" \
       NFV_NODE="${NODE_NAME}" NFV_FP="${PIN_FP}" \
       NFV_TOKEN_ID="${SVC_USER}!${TOKEN_NAME}" NFV_TOKEN_SECRET="${TOKEN_SECRET}"
python3 - <<'PYEOF'
import hashlib, http.client, json, os, ssl, sys, time, urllib.parse

url = urllib.parse.urlsplit(os.environ["NFV_URL"] + "/firstboot-credentials")
path = url.path + (f"?{url.query}" if url.query else "")
body = json.dumps({
    "serial": os.environ["NFV_SERIAL"],
    "key": os.environ["NFV_KEY"],
    "node_name": os.environ["NFV_NODE"],
    "token_id": os.environ["NFV_TOKEN_ID"],
    "token_secret": os.environ["NFV_TOKEN_SECRET"],
}).encode()
fp = os.environ.get("NFV_FP", "").replace(":", "").lower()
pinned = url.scheme == "https" and bool(fp)
if url.scheme == "https":
    # Pinned: CA verification off — the fingerprint check below IS the
    # verification. Unpinned https keeps normal CA verification.
    ctx = ssl._create_unverified_context() if pinned else ssl.create_default_context()


class PinMismatch(Exception):
    pass


def post_once():
    # The fingerprint is checked on the SAME connection that then carries the
    # token — no window between "verified" and "sent" (every retry repeats
    # connect + verify).
    if url.scheme == "https":
        conn = http.client.HTTPSConnection(url.hostname, url.port or 443, timeout=30, context=ctx)
    else:
        conn = http.client.HTTPConnection(url.hostname, url.port or 80, timeout=30)
    try:
        conn.connect()
        if pinned:
            seen = hashlib.sha256(conn.sock.getpeercert(binary_form=True)).hexdigest()
            if seen != fp:
                raise PinMismatch(f"answer-service cert fingerprint mismatch: {seen} != {fp}")
        conn.request("POST", path, body=body, headers={"Content-Type": "application/json"})
        resp = conn.getresponse()
        text = resp.read().decode(errors="replace")
        if resp.status >= 400:
            raise OSError(f"HTTP {resp.status}: {text[:300]}")
        return text
    finally:
        conn.close()


for attempt in range(10):
    try:
        print(post_once())
        break
    except PinMismatch as exc:
        sys.exit(f"{exc} — token NOT sent")
    except (OSError, http.client.HTTPException) as exc:
        print(f"phone-home attempt {attempt + 1}/10 failed: {exc}", file=sys.stderr)
        time.sleep(min(60, 5 * (attempt + 1)))
else:
    sys.exit("phone-home failed after 10 attempts — token NOT stored in Nautobot")
PYEOF
log "credentials stored in Nautobot — firstboot complete"

{% if data_pool -%}
# --- data pool (profile install.data_pool): ZFS {{ data_pool.raid }} over the
#     {{ data_pool.count }} largest UNUSED whole disks, registered as the
#     zfspool storage {{ data_pool.pve_storage }}. Runs AFTER the credentials
#     phone-home so a storage problem can never cost the node its token.
#     Fail-closed: a pool of this name found on disk (reinstall) is imported;
#     otherwise creation needs exactly {{ data_pool.count }} equal-sized,
#     signature-free disks >= {{ data_pool.min_size_gib }} GiB, else it logs and
#     skips — it never writes to a disk carrying a filesystem/zfs/LVM label.
#     Every failure below is logged, not fatal (set -e is bypassed via if). ---
count_of() { echo "$#"; }   # array length helper (bash ${ #arr[@] } would open a Jinja comment)
POOL={{ data_pool.name | shquote }}
POOL_STORAGE={{ data_pool.pve_storage | shquote }}
POOL_COUNT={{ data_pool.count }}
POOL_MIN_BYTES=$(( {{ data_pool.min_size_gib }} * 1073741824 ))
if zpool list -H -o name "${POOL}" >/dev/null 2>&1; then
  log "data pool ${POOL} already present — leaving it alone"
elif zpool import -d /dev/disk/by-id -f "${POOL}" >/dev/null 2>&1; then
  log "data pool ${POOL} found on disk and imported (reinstall — data kept)"
else
  CANDS=()
  while read -r name size; do
    dev="/dev/${name}"
    [ "${size}" -ge "${POOL_MIN_BYTES}" ] || continue
    # partitions or holders => in use (the rpool mirror members live here)
    [ "$(lsblk -n -o NAME "${dev}" | wc -l)" -eq 1 ] || continue
    # any filesystem / zfs_member / LVM2_member / raid signature => not ours
    [ -z "$(blkid -p -o value -s TYPE "${dev}" 2>/dev/null)" ] || continue
    CANDS+=("${name} ${size}")
  done < <(lsblk -dbn -o NAME,SIZE,TYPE,RM | awk '$3=="disk" && $4=="0" {print $1, $2}')
  if [ "$(count_of "${CANDS[@]}")" -eq 0 ]; then
    log "data pool ${POOL}: no unused signature-free disks >= {{ data_pool.min_size_gib }} GiB — skipped"
  else
    mapfile -t SORTED < <(printf '%s\n' "${CANDS[@]}" | sort -k2,2nr -k1,1)
    top_size="${SORTED[0]##* }"
    SEL=()
    for entry in "${SORTED[@]}"; do
      [ "${entry##* }" = "${top_size}" ] && SEL+=("${entry%% *}")
    done
    n_sel="$(count_of "${SEL[@]}")"
    if [ "${n_sel}" -ne "${POOL_COUNT}" ]; then
      log "data pool ${POOL}: need exactly ${POOL_COUNT} unused equal-sized disks, found ${n_sel} of ${top_size} bytes (${SEL[*]:-none}) — refusing, nothing written"
    else
      IDS=()
      for name in "${SEL[@]}"; do
        # stable by-id name (ata-/scsi-/nvme-, never a partition link)
        id="$(find /dev/disk/by-id -maxdepth 1 \( -name 'ata-*' -o -name 'scsi-*' -o -name 'nvme-*' \) ! -name '*-part*' -printf '%p %l\n' 2>/dev/null \
              | awk -v n="${name}" '$2 ~ ("/" n "$") {print $1; exit}')"
        IDS+=("${id:-/dev/${name}}")
      done
      log "data pool ${POOL}: creating {{ data_pool.raid }} over ${IDS[*]}"
      if zpool create -o ashift=12 -O compression=on -O atime=off "${POOL}" {{ data_pool.raid }} "${IDS[@]}"; then
        log "data pool ${POOL} created"
      else
        log "data pool ${POOL}: zpool create failed (rc=$?) — pool NOT created"
      fi
    fi
  fi
fi
if zpool list -H -o name "${POOL}" >/dev/null 2>&1; then
  if grep -q "^zfspool: ${POOL_STORAGE}\$" /etc/pve/storage.cfg 2>/dev/null; then
    log "PVE storage ${POOL_STORAGE} already registered"
  elif pvesm add zfspool "${POOL_STORAGE}" --pool "${POOL}" --content images,rootdir --sparse 1; then
    log "PVE storage ${POOL_STORAGE} registered (zfspool ${POOL}, content images,rootdir)"
  else
    log "PVE storage ${POOL_STORAGE}: pvesm add failed (rc=$?) — register it by hand"
  fi
fi

{% endif -%}
{% if data_volume -%}
# --- data volume (profile install.data_volume): LVM-thin on the largest UNUSED
#     whole disk — the RAID adapter's data virtual drive — registered as the
#     lvmthin storage {{ data_volume.pve_storage }}. Runs AFTER the credentials
#     phone-home so a storage problem can never cost the node its token.
#     A volume group of this name found on disk (reinstall) is reused — the
#     VM disks on it survive — but registered only if it holds the thin
#     pool {{ data_volume.thinpool }} (else a log line says why); otherwise
#     creation needs exactly ONE signature-free disk
#     >= {{ data_volume.min_size_gib }} GiB at the largest unused size, else it
#     logs and skips. Nothing here is fatal (set -e is
#     bypassed via if). ---
count_of() { echo "$#"; }   # array length helper (bash ${ #arr[@] } would open a Jinja comment)
VG={{ data_volume.vg | shquote }}
THINPOOL={{ data_volume.thinpool | shquote }}
VOL_STORAGE={{ data_volume.pve_storage | shquote }}
VOL_MIN_BYTES=$(( {{ data_volume.min_size_gib }} * 1073741824 ))
if vgs "${VG}" >/dev/null 2>&1; then
  log "volume group ${VG} already present (reinstall — data kept) — reusing it"
else
  CANDS=()
  while read -r name size; do
    dev="/dev/${name}"
    [ "${size}" -ge "${VOL_MIN_BYTES}" ] || continue
    # partitions or holders => in use (the boot volume lives here)
    [ "$(lsblk -n -o NAME "${dev}" | wc -l)" -eq 1 ] || continue
    # any filesystem / zfs_member / LVM2_member / raid signature => not ours
    [ -z "$(blkid -p -o value -s TYPE "${dev}" 2>/dev/null)" ] || continue
    CANDS+=("${name} ${size}")
  done < <(lsblk -dbn -o NAME,SIZE,TYPE,RM | awk '$3=="disk" && $4=="0" {print $1, $2}')
  if [ "$(count_of "${CANDS[@]}")" -eq 0 ]; then
    log "data volume ${VG}: no unused signature-free disk >= {{ data_volume.min_size_gib }} GiB — skipped"
  else
    mapfile -t SORTED < <(printf '%s\n' "${CANDS[@]}" | sort -k2,2nr -k1,1)
    top_size="${SORTED[0]##* }"
    SEL=()
    for entry in "${SORTED[@]}"; do
      [ "${entry##* }" = "${top_size}" ] && SEL+=("${entry%% *}")
    done
    n_sel="$(count_of "${SEL[@]}")"
    if [ "${n_sel}" -ne 1 ]; then
      log "data volume ${VG}: need exactly one unused disk at the largest size, found ${n_sel} of ${top_size} bytes (${SEL[*]:-none}) — refusing, nothing written"
    else
      name="${SEL[0]}"
      id="$(find /dev/disk/by-id -maxdepth 1 \( -name 'scsi-*' -o -name 'ata-*' -o -name 'nvme-*' \) ! -name '*-part*' -printf '%p %l\n' 2>/dev/null \
            | awk -v n="${name}" '$2 ~ ("/" n "$") {print $1; exit}')"
      dev="${id:-/dev/${name}}"
      log "data volume ${VG}: creating LVM-thin pool ${VG}/${THINPOOL} on ${dev}"
      if pvcreate "${dev}" && vgcreate "${VG}" "${dev}" && lvcreate -l 98%FREE --thinpool "${THINPOOL}" "${VG}"; then
        log "data volume ${VG}/${THINPOOL} created"
      else
        log "data volume ${VG}: LVM setup failed (rc=$?) — NOT created"
      fi
    fi
  fi
fi
if lvs "${VG}/${THINPOOL}" >/dev/null 2>&1; then
  if grep -q "^lvmthin: ${VOL_STORAGE}\$" /etc/pve/storage.cfg 2>/dev/null; then
    log "PVE storage ${VOL_STORAGE} already registered"
  elif pvesm add lvmthin "${VOL_STORAGE}" --vgname "${VG}" --thinpool "${THINPOOL}" --content images,rootdir; then
    log "PVE storage ${VOL_STORAGE} registered (lvmthin ${VG}/${THINPOOL}, content images,rootdir)"
  else
    log "PVE storage ${VOL_STORAGE}: pvesm add failed (rc=$?) — register it by hand"
  fi
elif vgs "${VG}" >/dev/null 2>&1; then
  # A reused VG (hand-built unit, or a reinstall after an lvcreate failure)
  # without the profile's thin pool: never create or rename anything on it.
  log "data volume ${VG}: volume group present but thin pool ${VG}/${THINPOOL} missing — PVE storage ${VOL_STORAGE} NOT registered; create the pool by hand (lvcreate -l 98%FREE --thinpool ${THINPOOL} ${VG}, or lvrename an existing pool to ${THINPOOL}) and pvesm add lvmthin ${VOL_STORAGE} --vgname ${VG} --thinpool ${THINPOOL} --content images,rootdir, or wipe the VG and reinstall"
fi

{% endif -%}
# --- host-baseline inputs (decision #55): packages, serial console, ZFS ARC
#     limit and the subscription-nag hook — from the Device's config context
#     (host_baseline) and the DeviceType profile (install.serial_console).
#     Like the storage step they run AFTER the credentials phone-home; each is
#     idempotent, logs what it did, and never stops the script (set -e is
#     bypassed via ||; the Host Baseline job re-ensures the packages). ---
nfv_count() { echo "$#"; }   # array length helper (bash ${ #arr[@] } would open a Jinja comment)
NFV_PKGS=({% for pkg in packages %} {{ pkg | shquote }}{% endfor %} )
nfv_packages() {
  local pkg
  local missing=()
  for pkg in "${NFV_PKGS[@]}"; do
    case "$(dpkg-query -W -f='${db:Status-Abbrev}' "${pkg}" 2>/dev/null)" in
      ii*) ;;
      *) missing+=("${pkg}") ;;
    esac
  done
  if [ "$(nfv_count "${missing[@]}")" -eq 0 ]; then
    log "packages: ${NFV_PKGS[*]} already installed"
  else
    apt-get update -q >/dev/null 2>&1 || log "packages: apt-get update reported errors — trying the install anyway"
    if ! DEBIAN_FRONTEND=noninteractive apt-get install -y -q -o Dpkg::Options::=--force-confdef \
         -o Dpkg::Options::=--force-confold "${missing[@]}" >/dev/null 2>&1; then
      log "packages: apt-get install ${missing[*]} FAILED — the Host Baseline job retries it"
      return 1
    fi
    log "packages: installed ${missing[*]}"
  fi
  if systemctl enable --now lldpd >/dev/null 2>&1; then
    log "packages: lldpd enabled"
  else
    log "packages: could not enable lldpd"
  fi
}
nfv_packages || log "packages step incomplete — continuing"

{% if serial_console -%}
# Serial console: the profile declares the port, the SoT the line settings.
# GRUB gets a drop-in (sourced after /etc/default/grub); systemd-boot layouts
# (proxmox-boot-tool, ZFS on UEFI) also /etc/kernel/cmdline. Refreshed through
# proxmox-boot-tool when it manages the ESPs (/etc/kernel/proxmox-boot-uuids),
# else update-grub — on ext4/LVM installs the tool is present but manages
# nothing, and its refresh would skip GRUB entirely.
NFV_SERIAL_TTY={{ serial_console.tty | shquote }}
NFV_SERIAL_CONSOLE={{ serial_console.console_arg | shquote }}
NFV_SERIAL_GRUB={{ serial_console.grub_command | shquote }}
nfv_serial_console() {
  local dropin=/etc/default/grub.d/nfv-serial-console.cfg tmp cmdline changed=0
  mkdir -p /etc/default/grub.d || return 1
  tmp="$(mktemp)" || return 1
  cat > "${tmp}" <<EOF
# Managed by nfv-firstboot: serial console from the SoT — the DeviceType
# profile's install.serial_console (port) + the config context's
# host_baseline.serial_console (line settings). A reinstall regenerates it.
GRUB_CMDLINE_LINUX="\${GRUB_CMDLINE_LINUX} console=tty0 console=${NFV_SERIAL_CONSOLE} 8250.nr_uarts=8"
GRUB_TERMINAL="console serial"
GRUB_SERIAL_COMMAND="${NFV_SERIAL_GRUB}"
EOF
  if cmp -s "${tmp}" "${dropin}"; then
    rm -f "${tmp}"
    log "serial console: ${dropin} already up to date"
  elif install -m 0644 "${tmp}" "${dropin}"; then
    rm -f "${tmp}"
    changed=1
    log "serial console: wrote ${dropin} (console=${NFV_SERIAL_CONSOLE}; ${NFV_SERIAL_GRUB})"
  else
    rm -f "${tmp}"
    return 1
  fi
  if [ -f /etc/kernel/cmdline ]; then
    cmdline="$(sed -E 's/(^| )(console=[^ ]*|8250\.nr_uarts=[^ ]*)//g; s/  +/ /g; s/^ //; s/ $//' /etc/kernel/cmdline) console=tty0 console=${NFV_SERIAL_CONSOLE} 8250.nr_uarts=8"
    if [ "$(cat /etc/kernel/cmdline)" != "${cmdline}" ]; then
      printf '%s\n' "${cmdline}" > /etc/kernel/cmdline || return 1
      changed=1
      log "serial console: /etc/kernel/cmdline updated"
    fi
  fi
  if [ "${changed}" -eq 1 ]; then
    if command -v proxmox-boot-tool >/dev/null 2>&1 && [ -s /etc/kernel/proxmox-boot-uuids ]; then
      if proxmox-boot-tool refresh >/dev/null 2>&1; then
        log "serial console: proxmox-boot-tool refresh done"
      else
        log "serial console: proxmox-boot-tool refresh FAILED"
        return 1
      fi
    elif update-grub >/dev/null 2>&1; then
      log "serial console: update-grub done"
    else
      log "serial console: update-grub FAILED"
      return 1
    fi
  fi
  if ! systemctl enable "serial-getty@${NFV_SERIAL_TTY}.service" >/dev/null 2>&1; then
    log "serial console: could not enable serial-getty@${NFV_SERIAL_TTY}"
    return 1
  fi
  if [ -e "/dev/${NFV_SERIAL_TTY}" ]; then
    systemctl start "serial-getty@${NFV_SERIAL_TTY}.service" >/dev/null 2>&1 || true
  fi
  log "serial console: serial-getty@${NFV_SERIAL_TTY} enabled; kernel and GRUB output on ${NFV_SERIAL_TTY} from the next reboot"
}
nfv_serial_console || log "serial console step incomplete — continuing"
{% else -%}
log {{ ("serial console: " ~ serial_console_note) | shquote }}
{% endif %}
{% if zfs_arc_max_bytes -%}
NFV_ARC_MAX={{ zfs_arc_max_bytes }}
nfv_zfs_arc() {
  local want="options zfs zfs_arc_max=${NFV_ARC_MAX}"
  if [ "$(cat /etc/modprobe.d/zfs.conf 2>/dev/null)" = "${want}" ]; then
    log "zfs arc: /etc/modprobe.d/zfs.conf already sets zfs_arc_max=${NFV_ARC_MAX}"
  else
    printf '%s\n' "${want}" > /etc/modprobe.d/zfs.conf || return 1
    log "zfs arc: /etc/modprobe.d/zfs.conf now sets zfs_arc_max=${NFV_ARC_MAX}"
    if update-initramfs -u -k all >/dev/null 2>&1; then
      log "zfs arc: initramfs updated"
    else
      log "zfs arc: update-initramfs FAILED — the limit applies only once the initramfs is rebuilt"
      return 1
    fi
  fi
  if [ -w /sys/module/zfs/parameters/zfs_arc_max ]; then
    if echo "${NFV_ARC_MAX}" > /sys/module/zfs/parameters/zfs_arc_max; then
      log "zfs arc: runtime limit set as well"
    fi
  fi
}
nfv_zfs_arc || log "zfs arc step incomplete — continuing"
{% else -%}
log "zfs arc: no host_baseline.zfs_arc_max_bytes in the SoT — left at the ZFS default"
{% endif %}
{% if remove_nag -%}
# Subscription nag (host_baseline.remove_subscription_nag): the project's own
# idempotent hook — a script patching the widget toolkit the standard PVE 8/9
# way plus an apt post-invoke hook that re-applies it after every package run.
nfv_subscription_nag() {
  cat > /usr/local/sbin/nfv-remove-subscription-nag <<'NAGEOF' || return 1
#!/bin/sh
# Managed by nfv-firstboot (host_baseline.remove_subscription_nag in the SoT).
# Removes the "No valid subscription" dialog from the Proxmox VE web UI by
# neutralising the widget toolkit's subscription check — the standard edit for
# PVE 8/9, restricted to the exact expression. Idempotent; re-run by the apt
# hook /etc/apt/apt.conf.d/86nfv-remove-subscription-nag after every package
# run (a proxmox-widget-toolkit upgrade restores the stock file). ALWAYS exits
# 0, so it can never fail apt; logs to the journal (tag below).
JS=/usr/share/javascript/proxmox-widget-toolkit/proxmoxlib.js
TAG=nfv-remove-subscription-nag
say() { logger -t "$TAG" -- "$*" 2>/dev/null; echo "$TAG: $*" >&2; }
[ -f "$JS" ] || { say "$JS not found - nothing to patch"; exit 0; }
grep -q 'NoMoreNagging' "$JS" && exit 0
if grep -qF "data.status.toLowerCase() !== 'active'" "$JS"; then
  if sed -i "s/data\.status\.toLowerCase() !== 'active'/data.status.toLowerCase() === 'NoMoreNagging'/" "$JS" \
     && grep -q 'NoMoreNagging' "$JS"; then
    say "subscription dialog removed from $JS"
  else
    say "patching $JS FAILED - the UI keeps the subscription dialog"
  fi
else
  say "pattern not found in $JS (proxmox-widget-toolkit $(dpkg-query -W -f='${Version}' proxmox-widget-toolkit 2>/dev/null)) - the UI keeps the subscription dialog; this toolkit version needs a new pattern"
fi
exit 0
NAGEOF
  chmod 0755 /usr/local/sbin/nfv-remove-subscription-nag || return 1
  cat > /etc/apt/apt.conf.d/86nfv-remove-subscription-nag <<'APTEOF' || return 1
// Managed by nfv-firstboot (host_baseline.remove_subscription_nag): re-apply
// the subscription-nag patch after every dpkg run. The script always exits 0
// and `|| true` keeps apt safe even if it is missing or broken.
DPkg::Post-Invoke { "if [ -x /usr/local/sbin/nfv-remove-subscription-nag ]; then /usr/local/sbin/nfv-remove-subscription-nag || true; fi"; };
APTEOF
  log "subscription nag: hook installed (/usr/local/sbin/nfv-remove-subscription-nag + apt post-invoke)"
  /usr/local/sbin/nfv-remove-subscription-nag 2>&1 | while read -r line; do log "subscription nag: ${line}"; done
  systemctl try-reload-or-restart pveproxy.service >/dev/null 2>&1 || true
}
nfv_subscription_nag || log "subscription nag step incomplete — continuing"
{% else -%}
log "subscription nag: not requested (host_baseline.remove_subscription_nag is not true) — UI unchanged"
{% endif %}
# Single-use package: remove so the hook can never re-run on later boots.
apt-get -y purge proxmox-first-boot >/dev/null 2>&1 || true
