# NFV add-on variables — these live in the compose PROJECT's .env file (the
# file compose reads for ${} interpolation; setup.sh seeds them there for
# you). They are NOT container env files — local.env / shared.env untouched.

# Path to your nautobot-proxmox checkout (build context for the service).
NFV_PROXMOX_REPO=/opt/nautobot-proxmox

# A Nautobot API token the answer service authenticates with.
NFV_NAUTOBOT_TOKEN=

# How INSTALLING NODES reach the service — a LAN address, never localhost.
NFV_PUBLIC_URL=https://192.0.2.10:8800

# SHA256 of nfv-helper/tls/answer-service.crt — setup.sh prints and seeds it.
# Pass the SAME value to prepare-install-iso.sh --fingerprint.
NFV_CERT_FINGERPRINT=

# Optional overrides:
#NFV_NAUTOBOT_URL=http://nautobot:8080   # your Nautobot service name : internal port
#NFV_DOMAIN=nfv.lab
#NFV_TIMEZONE=America/Chicago
